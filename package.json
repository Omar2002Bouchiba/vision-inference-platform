{
  "name": "vision-inference-platform",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript API platform for image and video object detection",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",

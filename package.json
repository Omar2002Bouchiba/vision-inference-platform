    "seed": "node dist/seed.js",
    "test": "npm run build && jest --runInBand"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bull": "^4.16.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "jest": "^30.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"

@startuml
title Vision Inference Platform - Use Cases
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F4F8FC
  BorderColor #24527A
  ArrowColor #24527A
}

actor Visitor
actor "Authenticated user" as User
actor Administrator as Admin

User --|> Visitor
Admin --|> User

rectangle "Vision Inference Platform" {
  usecase "Log in" as Login
  usecase "View credit balance" as Balance
  usecase "Create, list, view, update,\nand logically delete datasets" as Dataset
  usecase "Upload image or MP4 video\nto an owned dataset" as Upload
  usecase "Request YOLO11n inference" as Infer
  usecase "Check processing status\nand JSON detections" as Status
  usecase "Retrieve original and\nannotated image/frame" as Frame
  usecase "Add credits to a user account" as TopUp
}

Visitor --> Login
User --> Balance
User --> Dataset
User --> Upload
User --> Infer
User --> Status
User --> Frame
Admin --> TopUp
note right of TopUp
  Requires the admin role.
  The administrator's own balance
  is not required for this route.
end note
note bottom of Frame
  Available only after the processing
  has completed successfully.
end note
@enduml
